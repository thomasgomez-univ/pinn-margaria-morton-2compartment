# ============================================================
# Generated outputs (regenerable from source)
# ============================================================
# Figures. The three figures of the manuscript are shipped so that the
# repository is self-contained; anything else generated here stays untracked.
figures/*
!figures/.gitkeep
!figures/fig_identifiability.pdf
!figures/fig_accuracy.pdf
!figures/fig_vs_baseline.pdf

# Numerical results (JSON, NumPy binaries)
results/*.json
results/*.npz
results/*.npy
results/*.pt
results/*.pth

# Synthetic datasets generated by the scripts
data/synthetic/*.csv
data/synthetic/*.json
data/synthetic/*.npz

# Logs and intermediate runs
logs/
runs/
mlruns/
wandb/
*.log
tmp/

